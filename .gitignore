# OS
.DS_Store
Thumbs.db

# Large datasets. Placeholders (.gitkeep, README.md) stay tracked.
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
data/interim/*
!data/interim/.gitkeep
!data/interim/README.md
data/processed/*
!data/processed/.gitkeep
!data/processed/README.md
data/graphs/*
!data/graphs/.gitkeep
!data/graphs/README.md

# Split ID lists under data/splits/ are small and should be committed.

# Generated training artifacts
outputs/checkpoints/*
!outputs/checkpoints/.gitkeep
outputs/predictions/*
!outputs/predictions/.gitkeep
outputs/logs/*
!outputs/logs/.gitkeep

# Model weights and graph binaries
*.pt
*.pth
*.ckpt
*.onnx
*.bin
*.h5
*.safetensors

# Joern installation and extracted graph binaries
joern/
joern-cli/
*.cpg

