.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Dataset lớn. Các file giữ chỗ (.gitkeep, README.md) vẫn được theo dõi.
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
data/interim/*
!data/interim/.gitkeep
!data/interim/README.md
data/processed/*
!data/processed/.gitkeep
!data/processed/README.md
data/graphs/*
!data/graphs/.gitkeep
!data/graphs/README.md

# Danh sách split ID trong data/splits/ có kích thước nhỏ và nên được commit.

# Artifact sinh ra trong quá trình train
outputs/checkpoints/*
!outputs/checkpoints/.gitkeep
outputs/predictions/*
!outputs/predictions/.gitkeep
outputs/logs/*
!outputs/logs/.gitkeep

# Trọng số model và file graph nhị phân
