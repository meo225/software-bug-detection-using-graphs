# Sao chép file này thành .env và điền các giá trị local.
# Không bao giờ commit .env, thông tin đăng nhập hoặc API key.

# Đường dẫn tùy chọn tới bản cài Joern local. Để trống cho đến khi bắt đầu trích xuất graph.
JOERN_PATH=

# Giá trị tùy chọn để ghi đè thư mục dữ liệu. Đường dẫn trong config tương đối với thư mục gốc repository.
DATA_ROOT=data
